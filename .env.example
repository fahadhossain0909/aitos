# AITOS Environment Template
# Copy to .env and replace ALL placeholder/secret values before running production.
# NEVER commit .env or real credentials to Git.

ENVIRONMENT=dev
LOG_LEVEL=INFO
REQUIRE_HUMAN_APPROVAL_FOR_PROD=true
DEBUG=false
TESTING=false

# Local development defaults only. Use dedicated secrets/overrides for production.
SECRETS_BACKEND=env
VAULT_ADDR=
VAULT_MOUNT=secret
VAULT_PATH=aitos
VAULT_TOKEN_FILE=/run/secrets/vault_token

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=local-development-only-change-this
REDIS_DATA_DIR=./data/eventbus/redis
REDIS_MAXMEMORY=2gb
REDIS_CPUS=0.75
REDIS_MEM_LIMIT=2.5g

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=aitos
CLICKHOUSE_DB=aitos
CLICKHOUSE_DATA_DIR=./data/databases/clickhouse
CLICKHOUSE_CPUS=0.35
CLICKHOUSE_MEM_LIMIT=2.5g

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-development-only-change-this
NEO4J_DATA_DIR=./data/databases/neo4j
NEO4J_LOG_DIR=./data/runtime/logs/neo4j
NEO4J_CPUS=0.25
NEO4J_MEM_LIMIT=2.5g

# Keep paper trading isolated from live execution during local development.
AITOS_TRADING_CPUS=1.00
AITOS_TRADING_MEM_LIMIT=2g

LEARNING_POLL_SECONDS=60
LEARNING_LOOKBACK_HOURS=168
LEARNING_MODEL_PATH=./data/runtime/models/online_rl/deep_value.pkl
LEARNING_STATE_PATH=./data/runtime/models/online_rl/worker_state.json
LEARNING_CPUS=0.10
LEARNING_MEM_LIMIT=512m

# Portable local data root; set an absolute path for a dedicated production data disk.
AITOS_DATA_ROOT=./data
AITOS_DATA_DISK_UUID=
AITOS_HOST_UID=
AITOS_HOST_GID=
CLICKHOUSE_UID=101
CLICKHOUSE_GID=101
REDIS_UID=999
REDIS_GID=999
NEO4J_UID=7474
NEO4J_GID=7474

# Durable research/artifact paths. ClickHouse remains the primary historical DB.
BACKTEST_DATA_DIR=./data/research/backtest
REPLAY_DATA_DIR=./data/research/replay
BACKUP_DIR=./data/artifacts/backups
SNAPSHOT_DIR=./data/artifacts/snapshots
MODEL_DATA_DIR=./data/runtime/models
RUNTIME_TMP_DIR=./data/runtime/tmp
ARTIFACTS_DATA_DIR=./data/artifacts
BACKTEST_CPUS=1.5
BACKTEST_MEM_LIMIT=3g
STORAGE_MAINTENANCE_DRY_RUN=true
STORAGE_MAINTENANCE_CPUS=0.05
STORAGE_MAINTENANCE_MEM_LIMIT=256m

# Local runtime paths are relative to the repository; production hosts may override them.
AITOS_BOOT_RUNTIME_DIR=./data/runtime/boot
BOOT_FREE_BUFFER_GB=10
DATA_DISK_MIN_FREE_GB=20
DATA_DISK_TARGET_FREE_GB=25

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW_MS=5000
BINANCE_HEDGE_MODE=false

DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=
APP_PORT=8000
APP_HOST=127.0.0.1

COMPOSE_PROJECT_NAME=aitos
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your_github_username

SECRET_KEY=replace-me
API_KEY=replace-me
DATABASE_URL=
SENTRY_DSN=
SLACK_WEBHOOK_URL=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Capital Flow & Entity Intelligence (read-only; opt-in profile)
AITOS_CFEI_ENABLED=false
AITOS_CFEI_POLL_SECONDS=15
AITOS_CFEI_METRICS_PORT=8121
CFEI_CPUS=0.10
CFEI_MEM_LIMIT=384m
# JSON arrays; configure only public RPC endpoints and explicitly selected contracts/pools/wallets.
AITOS_CFEI_BINANCE_SYMBOLS=[]
AITOS_CFEI_EVM=[]
AITOS_CFEI_DEX_POOLS=[]
AITOS_CFEI_SOLANA=[]


# Capital Flow & Entity Intelligence token metadata / point-in-time pricing.
# Only explicitly registered assets are normalized; no symbol/decimal guessing.
AITOS_CFEI_TOKENS=[]
AITOS_CFEI_ALLOW_USDT_USD_PROXY=false

# Official SEC EDGAR disclosures. Supply CIKs and a real contactable User-Agent.
AITOS_CFEI_SEC_CIKS=[]
AITOS_CFEI_SEC_USER_AGENT=
AITOS_CFEI_SEC_MAX_FILINGS_PER_POLL=25

# Official CFTC COT aggregate positioning (dataset ID and field map are operator supplied).
AITOS_CFEI_CFTC_COT=[]

# Optional Binance USD-M market-structure observer (L2 snapshot, not L3).
AITOS_CFEI_BINANCE_MARKET_SYMBOLS=[]
AITOS_CFEI_LARGE_TRADE_USD=100000

# Optional persistent entity evidence graph; disabled unless explicitly enabled.
AITOS_CFEI_NEO4J_ENABLED=false
NEO4J_DATABASE=neo4j
# Optional bounded EVM ERC-20 metadata discovery (symbols are never price-pair mappings)
AITOS_CFEI_EVM_TOKEN_DISCOVERY=[]
