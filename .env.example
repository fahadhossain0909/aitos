# AITOS Environment Template
# Copy to .env and replace ALL secret values before running production.
# NEVER commit .env or real credentials to Git.

ENVIRONMENT=production
LOG_LEVEL=INFO
REQUIRE_HUMAN_APPROVAL_FOR_PROD=true
DEBUG=false
TESTING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DATA_DIR=/mnt/aitos-data/eventbus/redis

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=aitos
CLICKHOUSE_DB=aitos
CLICKHOUSE_DATA_DIR=/mnt/aitos-data/databases/clickhouse

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATA_DIR=/mnt/aitos-data/databases/neo4j
NEO4J_LOG_DIR=/mnt/aitos-data/runtime/logs/neo4j

LEARNING_POLL_SECONDS=60
LEARNING_LOOKBACK_HOURS=168
LEARNING_MODEL_PATH=/mnt/aitos-data/runtime/models/online_rl/deep_value.pkl
LEARNING_STATE_PATH=/mnt/aitos-data/runtime/models/online_rl/worker_state.json

# Durable data disk. The filesystem is identified by UUID, never /dev/sdX.
AITOS_DATA_ROOT=/mnt/aitos-data
AITOS_DATA_DISK_UUID=
AITOS_HOST_UID=
AITOS_HOST_GID=
CLICKHOUSE_UID=101
CLICKHOUSE_GID=101
REDIS_UID=999
REDIS_GID=999
NEO4J_UID=7474
NEO4J_GID=7474

# Durable research/artifact paths. ClickHouse remains the primary historical DB.
BACKTEST_DATA_DIR=/mnt/aitos-data/research/backtest
REPLAY_DATA_DIR=/mnt/aitos-data/research/replay
BACKUP_DIR=/mnt/aitos-data/artifacts/backups
SNAPSHOT_DIR=/mnt/aitos-data/artifacts/snapshots
MODEL_DATA_DIR=/mnt/aitos-data/runtime/models
RUNTIME_TMP_DIR=/mnt/aitos-data/runtime/tmp
ARTIFACTS_DATA_DIR=/mnt/aitos-data/artifacts

# Boot-disk safety policy. Disposable runtime data belongs under AITOS_BOOT_RUNTIME_DIR.
AITOS_BOOT_RUNTIME_DIR=/var/lib/aitos
BOOT_FREE_BUFFER_GB=10
DATA_DISK_MIN_FREE_GB=20
DATA_DISK_TARGET_FREE_GB=25

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW_MS=5000
BINANCE_HEDGE_MODE=false

DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
DEPLOY_PORT=22
APP_PORT=8000
APP_HOST=0.0.0.0

COMPOSE_PROJECT_NAME=aitos
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your_github_username

SECRET_KEY=
API_KEY=
DATABASE_URL=
SENTRY_DSN=
SLACK_WEBHOOK_URL=
