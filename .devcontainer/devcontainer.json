{
  "name": "AITOS Python Test Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "forwardPorts": [8090, 8091, 8123, 6379, 7687],
  "portsAttributes": {
    "8090": { "label": "AITOS paper health", "onAutoForward": "notify" },
    "8091": { "label": "AITOS live health", "onAutoForward": "notify" },
    "8123": { "label": "ClickHouse HTTP (test only)", "onAutoForward": "silent" },
    "6379": { "label": "Redis (test only)", "onAutoForward": "silent" },
    "7687": { "label": "Neo4j Bolt (test only)", "onAutoForward": "silent" }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
