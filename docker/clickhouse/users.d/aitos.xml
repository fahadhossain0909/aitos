<clickhouse>
    <!-- User/profile settings belong in users.xml/users.d, not config.d. -->
    <profiles>
        <default>
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_use_adaptive_busy_timeout>0</async_insert_use_adaptive_busy_timeout>
            <!-- Keep synchronous acknowledgement while further reducing persistence wait. -->
            <async_insert_busy_timeout_ms>100</async_insert_busy_timeout_ms>
            <async_insert_max_data_size>1048576</async_insert_max_data_size>
        </default>
    </profiles>
</clickhouse>
