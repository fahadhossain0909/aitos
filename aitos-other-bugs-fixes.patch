+
+    async def health_check(self) -> HealthStatus:
+        return HealthStatus(
+            module_id=self.module_id,
+            status=(
+                ModuleStatus.HEALTHY if self._initialized else ModuleStatus.UNHEALTHY
+            ),
+            latency_ms=0.0,
